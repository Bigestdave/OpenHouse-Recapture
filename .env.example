# ============================================================================
# OpenHouse Environment Configuration
# ============================================================================

# Supabase Project Credentials
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Use "demo" for the seeded, offline product walkthrough. Set this to
# "production" only after the Supabase schema, RLS policies, storage buckets,
# and the openhouse-ai Edge Function have been deployed.
VITE_OPENHOUSE_MODE=demo
