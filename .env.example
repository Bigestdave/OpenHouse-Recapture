# ============================================================================
# OpenHouse Recapture browser configuration
# ============================================================================

# Supabase Project Credentials
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Use "demo" only for visual rehearsal. Set this to "production" after the
# separate Recapture Supabase schema and Edge Functions are deployed.
# Connector and Gemini secrets never belong in this browser file.
VITE_OPENHOUSE_MODE=demo
